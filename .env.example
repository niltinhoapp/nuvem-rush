# ---- Nuvemshop (App ID 34663) ----
NUVEMSHOP_APP_ID=34663
# Versao publica (usada no frontend pelo Nexo como clientId)
NEXT_PUBLIC_NUVEMSHOP_APP_ID=34663
NUVEMSHOP_CLIENT_SECRET=coloque_o_client_secret_aqui
NUVEMSHOP_REDIRECT_URI=https://seu-dominio.com/api/auth/nuvemshop/callback
# User-Agent e OBRIGATORIO pela API da Nuvemshop. Inclua nome do app + email de contato.
NUVEMSHOP_USER_AGENT="Nuvem Rush (parceiros@seuemail.com)"

# ---- Firebase Admin (backend) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Chave privada com \n escapados em uma unica linha
FIREBASE_PRIVATE_KEY=

# ---- Firebase Client (frontend) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# ---- Google Cloud Tasks (agendamento de disparos) ----
GCP_PROJECT_ID=
GCP_LOCATION=southamerica-east1
CLOUD_TASKS_QUEUE=dispatch-queue
DISPATCH_SERVICE_ACCOUNT_EMAIL=
APP_BASE_URL=https://seu-dominio.com

# ---- Canais de envio ----
RESEND_API_KEY=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# ---- WhatsApp (Meta Cloud API) ----
# Credenciais GLOBAIS (numero do Nuvem Rush) — usadas so como fallback para
# lojas que ainda nao conectaram a propria conta via Embedded Signup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
# Numero de teste da Meta (opcional): se definido, o botao "Enviar mensagem
# de teste" do dashboard usa este numero em vez do de producao. Serve para
# gravar os videos da analise sem alterar o WHATSAPP_PHONE_NUMBER_ID real.
WHATSAPP_TEST_PHONE_NUMBER_ID=

# ---- WhatsApp Embedded Signup (Tech Provider) ----
# App da Meta "Nuvem Rush" (id publico, vai pro frontend)
NEXT_PUBLIC_META_APP_ID=908269564938670
# Chave secreta do app (painel dev > Configuracoes do app > Basico) — NUNCA no frontend
META_APP_SECRET=
# Configuration ID do Embedded Signup ("Nuvem Rush WhatsApp" — criada em
# 17/07/2026 a partir do modelo "Cadastro incorporado do WhatsApp", token de
# usuario do sistema com expiracao em 60 dias -> renovar via fb_exchange_token)
NEXT_PUBLIC_WHATSAPP_ES_CONFIG_ID=1561577032141885
# String definida por voce; deve ser identica a informada no painel da Meta
# ao configurar o webhook (Verify token).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ---- IA ----
OPENAI_API_KEY=

# ---- Seguranca interna ----
# Segredo usado para assinar/validar o callback -> /api/dispatch
INTERNAL_DISPATCH_SECRET=
# Segredo do Vercel Cron (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
